+            if not target_mdx.exists() and not target_idx.exists():
+                broken.append(f"{url} ('{text}')")
+
+        passed = len(broken) == 0
+        msg = f"04-munderije.mdx: {len(links)} links checked, {len(broken)} broken"
+        return TestCaseResult("Table of Contents Link Integrity", passed, msg, broken)
