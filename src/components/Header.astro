---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const id = Astro.locals.starlightRoute.id || '';
const pathname = Astro.url.pathname || '';
const is2000 = id.startsWith('2000') || pathname.includes('/2000');
const is40hedis = id.startsWith('40hedis') || pathname.includes('/40hedis');
const isDua = id.startsWith('dua') || pathname.includes('/dua');
const isPeyghemberler = id.startsWith('peyghemberler') || pathname.includes('/peyghemberler');
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden end-group">
		{shouldRenderSearch && <Search />}
		<div class="sl-hidden md:sl-flex right-group">
			<div class="sl-flex social-icons">
				<SocialIcons />
			</div>
			<ThemeSelect />
			{!is2000 && !is40hedis && !isDua && !isPeyghemberler && <LanguageSelect />}
		</div>
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.end-group {
			margin-inline-start: auto;
			align-items: center;
			gap: var(--sl-nav-gap);
			flex-shrink: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		/* Keep search compact beside theme/language (default Starlight makes it full-width). */
		.end-group :global(button[data-open-modal]) {
			width: auto;
			max-width: 14rem;
		}
	}
</style>
