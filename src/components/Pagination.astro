---
import Default from '@astrojs/starlight/components/Pagination.astro';

const id = Astro.locals.starlightRoute.id || '';
const pathname = Astro.url.pathname || '';
const is2000 = id.startsWith('2000') || pathname.includes('/2000');
const is40hedis = id.startsWith('40hedis') || pathname.includes('/40hedis');
const is100hedis = id.startsWith('100hedis') || pathname.includes('/100hedis');
const isDua = id.startsWith('dua') || pathname.includes('/dua');
const isPeyghemberler = id.startsWith('peyghemberler') || pathname.includes('/peyghemberler');
const isAile = id.startsWith('aile') || pathname.includes('/aile');
const isErebTili = id.startsWith('ereb-tili') || pathname.includes('/ereb-tili');

if (is2000 && Astro.locals.starlightRoute.pagination) {
	if (
		Astro.locals.starlightRoute.pagination.prev &&
		(!Astro.locals.starlightRoute.pagination.prev.href ||
			!Astro.locals.starlightRoute.pagination.prev.href.includes('/2000'))
	) {
		Astro.locals.starlightRoute.pagination.prev = undefined;
	}
	if (
		Astro.locals.starlightRoute.pagination.next &&
		(!Astro.locals.starlightRoute.pagination.next.href ||
			!Astro.locals.starlightRoute.pagination.next.href.includes('/2000'))
	) {
		Astro.locals.starlightRoute.pagination.next = undefined;
	}
}

if (is40hedis && Astro.locals.starlightRoute.pagination) {
