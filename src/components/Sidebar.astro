---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const id = Astro.locals.starlightRoute.id || '';
const pathname = Astro.url.pathname || '';
const is2000 = id.startsWith('2000') || pathname.includes('/2000');
const is40hedis = id.startsWith('40hedis') || pathname.includes('/40hedis');
const isDua = id.startsWith('dua') || pathname.includes('/dua');

let displaySidebar = sidebar;

const otherPortalsFor2000 = {
	type: 'group' as const,
	label: 'باشقا بۆلۈملەر',
	entries: [
		{
			type: 'link' as const,
			label: 'باش بەت (ئاساسىي كۆرۈنۈش)',
			href: '/',
			isCurrent: pathname === '/' || pathname === '',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'تەلىم – تەربىيە دەرسلىكى',
			href: '/derslik/',
			isCurrent: pathname === '/derslik/' || pathname === '/derslik',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'قىرىق ھەدىس',
			href: '/40hedis/',
			isCurrent: pathname === '/40hedis/' || pathname === '/40hedis',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'دۇئا ۋە زىكىرلەر',
			href: '/dua/',
			isCurrent: pathname === '/dua/' || pathname === '/dua',
			badge: undefined,
			attrs: {},
		},
	],
	collapsed: true,
	badge: undefined,
};

const otherPortalsFor40hedis = {
	type: 'group' as const,
	label: 'باشقا بۆلۈملەر',
	entries: [
		{
			type: 'link' as const,
			label: 'باش بەت (ئاساسىي كۆرۈنۈش)',
			href: '/',
			isCurrent: pathname === '/' || pathname === '',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'تەلىم – تەربىيە دەرسلىكى',
			href: '/derslik/',
			isCurrent: pathname === '/derslik/' || pathname === '/derslik',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: '2000 سوئال-جاۋاب',
			href: '/2000/',
			isCurrent: pathname === '/2000/' || pathname === '/2000',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'دۇئا ۋە زىكىرلەر',
			href: '/dua/',
			isCurrent: pathname === '/dua/' || pathname === '/dua',
			badge: undefined,
			attrs: {},
		},
	],
	collapsed: true,
	badge: undefined,
};

const otherPortalsForDua = {
	type: 'group' as const,
	label: 'باشقا بۆلۈملەر',
	entries: [
		{
			type: 'link' as const,
			label: 'باش بەت (ئاساسىي كۆرۈنۈش)',
			href: '/',
			isCurrent: pathname === '/' || pathname === '',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'تەلىم – تەربىيە دەرسلىكى',
			href: '/derslik/',
			isCurrent: pathname === '/derslik/' || pathname === '/derslik',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: '2000 سوئال-جاۋاب',
			href: '/2000/',
			isCurrent: pathname === '/2000/' || pathname === '/2000',
			badge: undefined,
			attrs: {},
		},
		{
			type: 'link' as const,
			label: 'قىرىق ھەدىس',
			href: '/40hedis/',
			isCurrent: pathname === '/40hedis/' || pathname === '/40hedis',
			badge: undefined,
			attrs: {},
		},
	],
	collapsed: true,
	badge: undefined,
};

if (is2000) {
	// On /2000 pages: isolate /2000 navigation panel completely
	const group2000 = sidebar.find(
		(entry) =>
			entry.type === 'group' &&
			(entry.label.includes('2000') ||
				(entry.entries && entry.entries.some((e) => e.type === 'link' && e.href.includes('/2000'))))
	);

	const topHeader = {
		type: 'link' as const,
		label: 'دىن ۋە ھايات: 2000 سوئالغا جاۋاب',
		href: '/2000/',
		isCurrent: pathname === '/2000/' || pathname === '/2000',
		badge: undefined,
		attrs: {},
	};

	const filter2000Entries = (entries: any[]) => {
		return entries.filter((e) => {
			if (e.type === 'link') {
				if (e.href === '/2000/' || e.href === '/2000') return false;
				return e.href.includes('/2000');
			}
			return true;
		});
	};

	if (group2000 && group2000.type === 'group') {
		displaySidebar = [topHeader, ...filter2000Entries(group2000.entries), otherPortalsFor2000];
	} else {
		displaySidebar = [
			topHeader,
			...sidebar.filter((entry) => {
				if (entry.type === 'link') {
					if (entry.href === '/2000/' || entry.href === '/2000') return false;
					return entry.href.includes('/2000');
				}
				if (entry.type === 'group') {
					return (
						entry.label.includes('2000') ||
						entry.entries?.some((e) => (e.type === 'link' && e.href.includes('/2000')) || (e.type === 'group' && e.label.includes('2000')))
					);
				}
				return false;
			}),
			otherPortalsFor2000,
		];
	}
} else if (is40hedis) {
	// On /40hedis pages: isolate /40hedis navigation panel completely
	const group40hedis = sidebar.find(
		(entry) =>
			entry.type === 'group' &&
			(entry.label.includes('ھەدىس') ||
				entry.label.includes('40') ||
				(entry.entries && entry.entries.some((e) => e.type === 'link' && e.href.includes('/40hedis'))))
	);

	const topHeader = {
		type: 'link' as const,
		label: 'قىرىق ھەدىس (ئىمام نەۋەۋى)',
		href: '/40hedis/',
		isCurrent: pathname === '/40hedis/' || pathname === '/40hedis',
		badge: undefined,
		attrs: {},
	};

	const filter40hedisEntries = (entries: any[]) => {
		return entries.filter((e) => {
			if (e.type === 'link') {
				if (e.href === '/40hedis/' || e.href === '/40hedis') return false;
				return e.href.includes('/40hedis');
			}
			return true;
		});
	};

	if (group40hedis && group40hedis.type === 'group') {
		displaySidebar = [topHeader, ...filter40hedisEntries(group40hedis.entries), otherPortalsFor40hedis];
	} else {
		displaySidebar = [
			topHeader,
			...sidebar.filter((entry) => {
				if (entry.type === 'link') {
					if (entry.href === '/40hedis/' || entry.href === '/40hedis') return false;
					return entry.href.includes('/40hedis');
				}
				if (entry.type === 'group') {
					return (
						entry.label.includes('ھەدىس') ||
						entry.label.includes('40') ||
						entry.entries?.some((e) => (e.type === 'link' && e.href.includes('/40hedis')) || (e.type === 'group' && e.label.includes('40hedis')))
					);
				}
				return false;
			}),
			otherPortalsFor40hedis,
		];
	}
} else if (isDua) {
	// On /dua pages: isolate /dua navigation panel completely
	const groupDua = sidebar.find(
		(entry) =>
			entry.type === 'group' &&
			(entry.label.includes('دۇئا') ||
				entry.label.includes('ھىسنۇل') ||
				entry.label.includes('dua') ||
				(entry.entries && entry.entries.some((e) => e.type === 'link' && e.href.includes('/dua'))))
	);

	const topHeader = {
		type: 'link' as const,
		label: 'ھىسنۇل مۇسلىم (دۇئا ۋە زىكىرلەر)',
		href: '/dua/',
		isCurrent: pathname === '/dua/' || pathname === '/dua',
		badge: undefined,
		attrs: {},
	};

	const filterDuaEntries = (entries: any[]) => {
		return entries.filter((e) => {
			if (e.type === 'link') {
				if (e.href === '/dua/' || e.href === '/dua') return false;
				return e.href.includes('/dua');
			}
			return true;
		});
	};

	if (groupDua && groupDua.type === 'group') {
		displaySidebar = [topHeader, ...filterDuaEntries(groupDua.entries), otherPortalsForDua];
	} else {
		displaySidebar = [
			topHeader,
			...sidebar.filter((entry) => {
				if (entry.type === 'link') {
					if (entry.href === '/dua/' || entry.href === '/dua') return false;
					return entry.href.includes('/dua');
				}
				if (entry.type === 'group') {
					return (
						entry.label.includes('دۇئا') ||
						entry.label.includes('ھىسنۇل') ||
						entry.label.includes('dua') ||
						entry.entries?.some((e) => (e.type === 'link' && e.href.includes('/dua')) || (e.type === 'group' && e.label.includes('dua')))
					);
				}
				return false;
			}),
			otherPortalsForDua,
		];
	}
} else {
	// On course pages (derslik): show course stages, and group supplementary resources under "پايدىلىق بۆلۈملەر"
	const rootStages = sidebar.filter((entry) => {
		if (entry.type === 'group') {
			return (
				!entry.label.includes('2000') &&
				!entry.label.includes('ھەدىس') &&
				!entry.label.includes('40') &&
				!entry.label.includes('دۇئا') &&
				!entry.label.includes('ھىسنۇل') &&
				!entry.label.includes('dua')
			);
		}
		return true;
	});

	const topHeader = {
		type: 'link' as const,
		label: 'تەلىم – تەربىيە پىروگراممىسى',
		href: '/derslik/',
		isCurrent: pathname === '/derslik/' || pathname === '/derslik',
		badge: undefined,
		attrs: {},
	};

	const usefulMaterialsGroup = {
		type: 'group' as const,
		label: 'پايدىلىق بۆلۈملەر',
		entries: [
			{
				type: 'link' as const,
				label: 'باش بەت (ئاساسىي كۆرۈنۈش)',
				href: '/',
				isCurrent: pathname === '/' || pathname === '',
				badge: undefined,
				attrs: {},
			},
			{
				type: 'link' as const,
				label: '2000 سوئال-جاۋاب',
				href: '/2000/',
				isCurrent: pathname === '/2000/' || pathname === '/2000',
				badge: undefined,
				attrs: {},
			},
			{
				type: 'link' as const,
				label: 'قىرىق ھەدىس',
				href: '/40hedis/',
				isCurrent: pathname === '/40hedis/' || pathname === '/40hedis',
				badge: undefined,
				attrs: {},
			},
			{
				type: 'link' as const,
				label: 'دۇئا ۋە زىكىرلەر',
				href: '/dua/',
				isCurrent: pathname === '/dua/' || pathname === '/dua',
				badge: undefined,
				attrs: {},
			},
		],
		collapsed: false,
		badge: undefined,
	};

	displaySidebar = [topHeader, ...rootStages, usefulMaterialsGroup];
}
---

<SidebarPersister>
	<SidebarSublist sublist={displaySidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
