---
interface Props {
	hideLanguage?: boolean;
}

const { hideLanguage = false } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const isEn = lang === 'en';
const pathname = Astro.url.pathname || '/';

const uyghurUrl = isEn ? (pathname.replace(/^\/en(\/|$)/, '/') || '/') : pathname;
const englishUrl = isEn ? pathname : ('/en' + (pathname.startsWith('/') ? pathname : '/' + pathname));

const labels = {
	settingsBtn: isEn ? 'Settings' : 'تەڭشەكلەر',
	modalTitle: isEn ? 'Settings' : 'تەڭشەكلەر',
	langTitle: isEn ? 'Language' : 'تىل',
	uyghur: 'ئۇيغۇرچە',
	english: 'English',
	themeTitle: isEn ? 'Appearance' : 'تېما',
	themeDark: isEn ? 'Dark' : 'قاراڭغۇ',
	themeLight: isEn ? 'Light' : 'يورۇق',
	themeAuto: isEn ? 'Auto' : 'سىستېما',
	fontSizeTitle: isEn ? 'Font Size' : 'خەت چوڭلۇقى',
	decrease: isEn ? 'Smaller font' : 'خەتنى كىچىكلىتىش',
	increase: isEn ? 'Larger font' : 'خەتنى چوڭايتىش',
	resetBtn: isEn ? 'Reset defaults' : 'ئەسلىگە قايتۇرۇش',
	closeBtn: isEn ? 'Close' : 'تاقاش',
};
---

<starlight-settings-modal class="settings-widget">
	<button
		type="button"
		class="settings-trigger-btn"
		data-settings-open
		aria-label={labels.settingsBtn}
		title={labels.settingsBtn}
		aria-haspopup="dialog"
	>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
			<circle cx="12" cy="12" r="3"/>
		</svg>
	</button>

	<dialog class="settings-dialog" data-settings-dialog aria-label={labels.modalTitle}>
		<div class="dialog-content">
			<!-- Compact Header -->
			<div class="dialog-header">
				<div class="header-title-group">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="title-icon" aria-hidden="true">
						<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
						<circle cx="12" cy="12" r="3"/>
					</svg>
					<h2 class="dialog-title">{labels.modalTitle}</h2>
				</div>
				<div class="header-actions">
					<button type="button" class="reset-icon-btn" data-settings-reset title={labels.resetBtn} aria-label={labels.resetBtn}>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
							<path d="M3 3v5h5"/>
						</svg>
					</button>
					<button type="button" class="dialog-close-btn" data-settings-close aria-label={labels.closeBtn}>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="18" y1="6" x2="6" y2="18"/>
							<line x1="6" y1="6" x2="18" y2="18"/>
						</svg>
					</button>
				</div>
			</div>

			<!-- Compact Body -->
			<div class="dialog-body">
				<!-- 1. Language Option (shown when multilingual applies) -->
				{!hideLanguage && (
					<div class="settings-row">
						<span class="row-label">{labels.langTitle}</span>
						<div class="segmented-control lang-switch">
							<a href={uyghurUrl} class:list={["seg-btn", { active: !isEn }]} aria-current={!isEn ? 'true' : undefined}>
								<span>{labels.uyghur}</span>
							</a>
							<a href={englishUrl} class:list={["seg-btn", { active: isEn }]} aria-current={isEn ? 'true' : undefined}>
								<span>{labels.english}</span>
							</a>
						</div>
					</div>
				)}

				<!-- 2. Theme Option -->
				<div class="settings-row">
					<span class="row-label">{labels.themeTitle}</span>
					<div class="segmented-control theme-switch">
						<button type="button" class="seg-btn theme-seg-btn" data-theme-val="dark">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
							</svg>
							<span>{labels.themeDark}</span>
						</button>
						<button type="button" class="seg-btn theme-seg-btn" data-theme-val="light">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="4"/>
								<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
							</svg>
							<span>{labels.themeLight}</span>
						</button>
						<button type="button" class="seg-btn theme-seg-btn" data-theme-val="auto">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="20" height="14" x="2" y="3" rx="2"/>
								<line x1="8" x2="16" y1="21" y2="21"/>
								<line x1="12" x2="12" y1="17" y2="21"/>
							</svg>
							<span>{labels.themeAuto}</span>
						</button>
					</div>
				</div>

				<!-- 3. Font Size Option -->
				<starlight-font-size-select class="settings-row font-size-row">
					<div class="row-header">
						<span class="row-label">{labels.fontSizeTitle}</span>
						<span class="font-pct-badge current-value" aria-hidden="true">100%</span>
					</div>
					<div class="font-stepper-control">
						<button
							type="button"
							class="font-step-btn decrease-btn"
							data-action="decrease"
							aria-label={labels.decrease}
							title={labels.decrease}
						>
							<span class="step-btn-text">A<span class="sign">−</span></span>
						</button>

						<div class="preset-pills-group">
							<button type="button" class="size-pill-btn" data-size-val="sm">88%</button>
							<button type="button" class="size-pill-btn" data-size-val="md">100%</button>
							<button type="button" class="size-pill-btn" data-size-val="lg">115%</button>
							<button type="button" class="size-pill-btn" data-size-val="xl">130%</button>
							<button type="button" class="size-pill-btn" data-size-val="2xl">145%</button>
						</div>

						<button
							type="button"
							class="font-step-btn increase-btn"
							data-action="increase"
							aria-label={labels.increase}
							title={labels.increase}
						>
							<span class="step-btn-text">A<span class="sign">+</span></span>
						</button>
					</div>
				</starlight-font-size-select>
			</div>
		</div>
	</dialog>
</starlight-settings-modal>

<script is:inline>
	if (typeof StarlightThemeProvider !== 'undefined') {
		StarlightThemeProvider.updatePickers();
	}
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';
	type FontSize = 'sm' | 'md' | 'lg' | 'xl' | '2xl';

	const THEME_KEY = 'starlight-theme';
	const FONT_KEY = 'starlight-font-size';
	const SIZES: FontSize[] = ['sm', 'md', 'lg', 'xl', '2xl'];
	const PCT_MAP: Record<FontSize, string> = {
		'sm': '88%',
		'md': '100%',
		'lg': '115%',
		'xl': '130%',
		'2xl': '145%',
	};

	const parseTheme = (val: unknown): Theme =>
		val === 'auto' || val === 'dark' || val === 'light' ? val : 'auto';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' ? localStorage.getItem(THEME_KEY) : 'auto');

	const storeTheme = (theme: Theme): void => {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(THEME_KEY, theme === 'light' || theme === 'dark' ? theme : '');
		}
	};

	const getPreferredColorScheme = (): Theme =>
		window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function applyTheme(theme: Theme): void {
		storeTheme(theme);
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		if (typeof (window as any).StarlightThemeProvider !== 'undefined') {
			(window as any).StarlightThemeProvider.updatePickers(theme);
		}
		window.dispatchEvent(new CustomEvent('starlight-theme-changed', { detail: { theme } }));
	}

	const parseFontSize = (val: unknown): FontSize =>
		SIZES.includes(val as FontSize) ? (val as FontSize) : 'md';

	const loadFontSize = (): FontSize =>
		parseFontSize(typeof localStorage !== 'undefined' ? localStorage.getItem(FONT_KEY) : 'md');

	const storeFontSize = (size: FontSize): void => {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(FONT_KEY, size);
		}
	};

	function applyFontSize(size: FontSize): void {
		document.documentElement.dataset.fontSize = size;
		storeFontSize(size);
		window.dispatchEvent(new CustomEvent('starlight-font-size-change', { detail: { size } }));
	}

	class StarlightSettingsModal extends HTMLElement {
		private triggerBtn: HTMLButtonElement | null = null;
		private dialog: HTMLDialogElement | null = null;
		private closeBtn: HTMLButtonElement | null = null;
		private resetBtn: HTMLButtonElement | null = null;
		private themeBtns: NodeListOf<HTMLButtonElement> | null = null;
		private sizeBtns: NodeListOf<HTMLButtonElement> | null = null;
		private currentValTag: HTMLElement | null = null;
		private decBtn: HTMLButtonElement | null = null;
		private incBtn: HTMLButtonElement | null = null;

		connectedCallback() {
			this.triggerBtn = this.querySelector('[data-settings-open]');
			this.dialog = this.querySelector('[data-settings-dialog]');
			this.closeBtn = this.querySelector('[data-settings-close]');
			this.resetBtn = this.querySelector('[data-settings-reset]');
			this.themeBtns = this.querySelectorAll('[data-theme-val]');
			this.sizeBtns = this.querySelectorAll('[data-size-val]');
			this.currentValTag = this.querySelector('.current-value');
			this.decBtn = this.querySelector('[data-action="decrease"]');
			this.incBtn = this.querySelector('[data-action="increase"]');

			this.updateUi();

			// Modal toggle
			this.triggerBtn?.addEventListener('click', () => {
				if (this.dialog && !this.dialog.open) {
					this.updateUi();
					this.dialog.showModal();
				}
			});

			this.closeBtn?.addEventListener('click', () => {
				if (this.dialog?.open) this.dialog.close();
			});

			this.dialog?.addEventListener('click', (e) => {
				if (e.target === this.dialog) this.dialog.close();
			});

			// Theme buttons
			this.themeBtns?.forEach((btn) => {
				btn.addEventListener('click', () => {
					const t = parseTheme(btn.getAttribute('data-theme-val'));
					applyTheme(t);
					this.updateThemeUi(t);
				});
			});

			// Font size pills
			this.sizeBtns?.forEach((btn) => {
				btn.addEventListener('click', () => {
					const s = parseFontSize(btn.getAttribute('data-size-val'));
					applyFontSize(s);
					this.updateFontUi(s);
				});
			});

			// Font size stepper
			this.decBtn?.addEventListener('click', () => {
				const curr = parseFontSize(document.documentElement.dataset.fontSize || loadFontSize());
				const idx = SIZES.indexOf(curr);
				if (idx > 0) {
					const next = SIZES[idx - 1];
					applyFontSize(next);
					this.updateFontUi(next);
				}
			});

			this.incBtn?.addEventListener('click', () => {
				const curr = parseFontSize(document.documentElement.dataset.fontSize || loadFontSize());
				const idx = SIZES.indexOf(curr);
				if (idx < SIZES.length - 1) {
					const next = SIZES[idx + 1];
					applyFontSize(next);
					this.updateFontUi(next);
				}
			});

			// Reset button
			this.resetBtn?.addEventListener('click', () => {
				applyTheme('auto');
				this.updateThemeUi('auto');
				applyFontSize('md');
				this.updateFontUi('md');
			});

			// Listen for external updates
			window.addEventListener('starlight-font-size-change', ((e: CustomEvent<{ size: FontSize }>) => {
				this.updateFontUi(e.detail.size);
			}) as EventListener);

			window.addEventListener('starlight-theme-changed', ((e: CustomEvent<{ theme: Theme }>) => {
				this.updateThemeUi(e.detail.theme);
			}) as EventListener);
		}

		private updateUi() {
			this.updateThemeUi(loadTheme());
			this.updateFontUi(loadFontSize());
		}

		private updateThemeUi(currentTheme: Theme) {
			this.themeBtns?.forEach((btn) => {
				const val = btn.getAttribute('data-theme-val');
				const isActive = val === currentTheme;
				btn.classList.toggle('active', isActive);
				btn.setAttribute('aria-pressed', String(isActive));
			});
		}

		private updateFontUi(currentSize: FontSize) {
			if (this.currentValTag) {
				this.currentValTag.textContent = PCT_MAP[currentSize] || '100%';
			}

			this.sizeBtns?.forEach((btn) => {
				const val = btn.getAttribute('data-size-val');
				const isActive = val === currentSize;
				btn.classList.toggle('active', isActive);
				btn.setAttribute('aria-pressed', String(isActive));
			});

			const idx = SIZES.indexOf(currentSize);
			if (this.decBtn) {
				this.decBtn.disabled = idx <= 0;
				this.decBtn.setAttribute('aria-disabled', String(idx <= 0));
			}
			if (this.incBtn) {
				this.incBtn.disabled = idx >= SIZES.length - 1;
				this.incBtn.setAttribute('aria-disabled', String(idx >= SIZES.length - 1));
			}
		}
	}

	if (!customElements.get('starlight-settings-modal')) {
		customElements.define('starlight-settings-modal', StarlightSettingsModal);
	}
</script>

<style>
	.settings-widget {
		display: inline-flex;
		align-items: center;
	}

	.settings-trigger-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.95rem;
		height: 1.95rem;
		border-radius: 9999px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition: all 0.2s ease;
		padding: 0;
	}

	.settings-trigger-btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
	}

	/* Compact Dialog */
	dialog.settings-dialog {
		position: fixed;
		inset: 0;
		margin: auto !important;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem !important;
		background: var(--sl-color-gray-7, #0f172a);
		color: var(--sl-color-gray-1);
		max-width: min(92vw, 21.5rem) !important;
		width: 21.5rem !important;
		height: auto !important;
		box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.6);
	}

	dialog.settings-dialog::backdrop {
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(3px);
	}

	.dialog-content {
		display: flex;
		flex-direction: column;
	}

	.dialog-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid var(--sl-color-gray-6);
	}

	.header-title-group {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.title-icon {
		color: var(--sl-color-accent);
	}

	.dialog-title {
		font-size: 0.95rem;
		font-weight: 600;
		margin: 0;
		color: var(--sl-color-white);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.reset-icon-btn,
	.dialog-close-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 0.35rem;
		border: 1px solid transparent;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition: all 0.15s ease;
		padding: 0;
	}

	.reset-icon-btn:hover,
	.dialog-close-btn:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.dialog-body {
		padding: 0.75rem 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.settings-row {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.row-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.row-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	/* Segmented switch */
	.segmented-control {
		display: flex;
		align-items: center;
		background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 2px;
		gap: 2px;
	}

	.seg-btn {
		flex: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		height: 1.85rem;
		border: none;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-size: 0.775rem;
		font-weight: 500;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
		user-select: none;
	}

	.seg-btn:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
	}

	.seg-btn.active {
		background: var(--sl-color-accent);
		color: #ffffff;
		font-weight: 600;
	}

	/* Font Size Stepper */
	.font-pct-badge {
		font-size: 0.725rem;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-accent-high, #38bdf8);
		font-weight: 700;
	}

	.font-stepper-control {
		display: flex;
		align-items: center;
		background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 2px;
		gap: 2px;
		height: 1.95rem;
	}

	.font-step-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.7rem;
		border-radius: 0.35rem;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	.font-step-btn:hover:not(:disabled) {
		background: var(--sl-color-gray-5);
		color: var(--sl-color-white);
	}

	.font-step-btn:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.step-btn-text {
		font-size: 0.825rem;
		font-weight: 700;
		line-height: 1;
		display: inline-flex;
		align-items: center;
	}

	.step-btn-text .sign {
		font-size: 0.7rem;
	}

	.preset-pills-group {
		display: flex;
		align-items: center;
		flex: 1;
		gap: 2px;
		justify-content: space-between;
	}

	.size-pill-btn {
		flex: 1;
		height: 1.7rem;
		border-radius: 0.35rem;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-size: 0.725rem;
