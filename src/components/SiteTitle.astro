---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle: defaultSiteTitle, lang } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname || '';
const id = Astro.locals.starlightRoute.id || '';

const isEn = lang === 'en' || pathname.startsWith('/en/');
const landingHref = isEn ? '/en/' : '/';
const isLandingPage =
	pathname === '/' || pathname === '/en/' || pathname === '/en' || pathname === '';

// Check known sections
const is2000 = id.startsWith('2000') || pathname.includes('/2000');
const is40hedis = id.startsWith('40hedis') || pathname.includes('/40hedis');
const is100hedis = id.startsWith('100hedis') || pathname.includes('/100hedis');
const isDua = id.startsWith('dua') || pathname.includes('/dua');
const isPeyghemberler = id.startsWith('peyghemberler') || pathname.includes('/peyghemberler');
const isAile = id.startsWith('aile') || pathname.includes('/aile');
const isErebTili = id.startsWith('ereb-tili') || pathname.includes('/ereb-tili');
const isNamaz = id.startsWith('namaz') || pathname.includes('/namaz');
const isHayat = id.startsWith('hayat') || pathname.includes('/hayat');
const isDerslik =
	id.startsWith('derslik') ||
	pathname.includes('/derslik') ||
	/^\/(en\/)?(1-|2-|3-|4-|5-|6-|introduction)/.test(pathname);

let sectionTitle = '';
let sectionHref = '';

if (is2000) {
	sectionTitle = isEn ? '2000 Q&A' : 'دىن ۋە ھايات: 2000 سوئالغا جاۋاب';
	sectionHref = isEn ? '/en/2000/' : '/2000/';
	// Update head/starlightRoute metadata for consistency
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (is40hedis) {
	sectionTitle = isEn ? 'Forty Hadith' : 'قىرىق ھەدىس';
	sectionHref = isEn ? '/en/40hedis/' : '/40hedis/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (is100hedis) {
	sectionTitle = isEn ? 'Selected 100 Hadiths' : 'تاللانغان 100 ھەدىس';
	sectionHref = isEn ? '/en/100hedis/' : '/100hedis/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isDua) {
	sectionTitle = isEn ? 'Hisnul Muslim (Dua)' : 'ھىسنۇل مۇسلىم (دۇئا ۋە زىكىرلەر)';
	sectionHref = isEn ? '/en/dua/' : '/dua/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isPeyghemberler) {
	sectionTitle = isEn ? 'History of Prophets' : 'پەيغەمبەرلەر تارىخى';
	sectionHref = isEn ? '/en/peyghemberler/' : '/peyghemberler/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isAile) {
	sectionTitle = isEn ? 'Family System in Islam' : 'ئىسلامدىكى ئائىلە تۈزۈمى';
	sectionHref = isEn ? '/en/aile/' : '/aile/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isErebTili) {
	sectionTitle = isEn ? 'Arabic Language Grammar' : 'ئەرەب تىلى دەرسلىكى گرامماتىكا قائىدىلىرى';
	sectionHref = isEn ? '/en/ereb-tili/' : '/ereb-tili/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isNamaz) {
	sectionTitle = isEn ? 'Basics of Prayer' : 'نامازدىن ساۋات';
	sectionHref = isEn ? '/en/namaz/' : '/namaz/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isHayat) {
	sectionTitle = isEn ? 'Value Your Life' : 'ھاياتىڭىزنى قەدىرلەڭ';
	sectionHref = isEn ? '/en/hayat/' : '/hayat/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (isDerslik) {
	sectionTitle = isEn ? 'Educational Program' : 'تەلىم – تەربىيە پىروگراممىسى';
	sectionHref = isEn ? '/en/derslik/' : '/derslik/';
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else if (!isLandingPage) {
	// Generic fallback for any future new section or page
	const cleanPath = pathname.replace(/^\/en\//, '/').replace(/^\//, '');
	const firstSegment = cleanPath.split('/')[0] || '';
	if (firstSegment) {
		sectionTitle = firstSegment.replace(/[-_]/g, ' ');
		sectionTitle = sectionTitle.charAt(0).toUpperCase() + sectionTitle.slice(1);
		sectionHref = isEn ? `/en/${firstSegment}/` : `/${firstSegment}/`;
	} else {
		sectionTitle = defaultSiteTitle;
		sectionHref = landingHref;
	}
	Astro.locals.starlightRoute.siteTitle = sectionTitle;
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
} else {
	Astro.locals.starlightRoute.siteTitleHref = landingHref;
}

const landingTooltip = isEn ? 'Go to Landing Page' : 'باش بەتكە قايتىش';
---

<div class="site-title-container sl-flex">
	<!-- Universal jump link to the landing page on top of the logo -->
	<a
		href={landingHref}
		class="site-logo-link sl-flex"
		title={landingTooltip}
		aria-label={landingTooltip}
	>
		{
			config.logo && logos.dark && (
				<>
					<img
						class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
						alt={config.logo.alt}
						src={logos.dark.src}
						width={logos.dark.width}
						height={logos.dark.height}
					/>
					{!('src' in config.logo) && (
						<img
							class="dark:sl-hidden print:block"
							alt={config.logo.alt}
							src={logos.light?.src}
							width={logos.light?.width}
							height={logos.light?.height}
						/>
					)}
				</>
			)
		}
	</a>

	{
		isLandingPage ? (
			<a href={landingHref} class="site-main-title" translate="no">
				{defaultSiteTitle}
			</a>
		) : (
			<div class="site-section-wrapper sl-flex">
				<span class="site-separator" aria-hidden="true">/</span>
				<a href={sectionHref} class="site-section-title" title={sectionTitle}>
					{sectionTitle}
				</a>
			</div>
		)
	}
</div>

<style>
	.site-title-container {
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		height: 100%;
	}

	.site-logo-link {
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
		padding: 0.2rem;
		border-radius: 0.375rem;
		transition: transform 0.2s ease, opacity 0.2s ease, filter 0.2s ease;
		cursor: pointer;
	}

	.site-logo-link:hover {
		transform: scale(1.08);
		filter: drop-shadow(0 2px 8px rgba(0, 153, 255, 0.4));
	}

	.site-logo-link:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.site-logo-link img {
		height: 2.3rem;
		width: auto;
		max-height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
		object-fit: contain;
	}

	:global([data-theme='light']) .site-logo-link img.light\:sl-hidden {
		display: none !important;
	}

	:global([data-theme='dark']) .site-logo-link img.dark\:sl-hidden {
		display: none !important;
	}


	.site-main-title {
		font-size: var(--sl-text-h4);
		font-weight: 700;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.site-main-title:hover {
		color: var(--sl-color-accent-high);
	}

	.site-section-wrapper {
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		overflow: hidden;
	}

	.site-separator {
		color: var(--sl-color-gray-4);
		font-size: 1.1rem;
		font-weight: 300;
		user-select: none;
		flex-shrink: 0;
	}

	.site-section-title {
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 22rem;
		transition: color 0.2s ease;
	}

	:root[data-theme='light'] .site-section-title {
		color: var(--sl-color-gray-1, #1e2329);
	}

	.site-section-title:hover {
		color: var(--sl-color-accent);
	}

	@media (max-width: 50rem) {
		.site-section-title {
			font-size: 1rem;
			max-width: 14rem;
		}
		.site-logo-link img {
			height: 2rem;
		}
	}

	@media (max-width: 30rem) {
		.site-section-title {
			max-width: 9rem;
		}
	}
</style>
