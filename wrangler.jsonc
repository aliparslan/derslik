{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "terbiye",
	"compatibility_date": "2026-09-12",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "force-trailing-slash"
	},
	// Prefer Workers Routes while existing DNS A/CNAME records remain.
	// After you delete conflicting @ and www DNS records, you can switch to
	// custom_domain routes (Cloudflare manages DNS + certs for you):
	// { "pattern": "terbiye.org", "custom_domain": true }
	"routes": [
		{ "pattern": "terbiye.org/*", "zone_name": "terbiye.org" },
		{ "pattern": "www.terbiye.org/*", "zone_name": "terbiye.org" }
	],
	"observability": {
		"enabled": true
	}
}
